<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile | Cahaya Travel</title>
</head>
<body>
    <%- include('partials/header') %>
    <h1>Profile</h1>
    <% if (success) { %>
    <div style="color: green;">
        <%= success %>
    </div>
    <% } else if(error) {%>
    <div style="color: red;">
        <%= error %>
    </div>
    <% } %>
    <form action="/profile/<%= dataProfile.id %>" method="post">
        <p>Name:</p>
        <input type="text" name="nama" value="<%= dataProfile.nama %>">
        <p>Photo:</p>
        <input type="text" name="foto" value="<%= dataProfile.foto %>">
        <p>KTP:</p>
        <input type="text" name="ktp" value="<%= dataProfile.ktp %>">
        <p>Phone Number:</p>
        <input type="text" name="phoneNumber" value="<%= dataProfile.phoneNumber %>">
        <p>Email:</p>
        <input type="text" name="email" id="" value="<%= dataProfile.User.email %>"><br><br>
        <input type="submit" value="Edit">
    </form>
    <br><br>
    <% if (sesi.role === 'admin') { %>
        <a href="/profile/<%= dataProfile.id %>/delete">Delete</a>
    <% } %>
</body>
</html>