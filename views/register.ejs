<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | Cahaya Travel</title>
    
    <style>
        /* Reset Dasar */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6; /* Warna latar belakang abu-abu terang */
            color: #333;
            display: flex;
            justify-content: center; /* Posisikan ke tengah horizontal */
            align-items: center; /* Posisikan ke tengah vertikal */
            min-height: 100vh; /* Memenuhi tinggi layar */
            padding: 30px 20px;
        }

        /* Container Form bergaya Kartu (Card) */
        .register-container {
            background-color: #ffffff;
            padding: 40px 30px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 450px; /* Sedikit lebih lebar dari halaman login karena isinya banyak */
        }

        /* Judul Halaman */
        h1 {
            color: #0056b3; /* Biru Cahaya Travel */
            font-size: 2rem;
            margin-bottom: 25px;
            font-weight: bold;
            text-align: center;
        }

        /* Styling Pesan Error (Alert) */
        .alert-danger {
            background-color: #ffe6e6;
            color: #cc0000;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid #ffb3b3;
            font-size: 0.95rem;
            font-weight: 600;
            text-align: center;
        }

        /* Styling Form dan Label */
        form label {
            font-weight: 600;
            color: #444;
            display: block;
            margin-bottom: 8px;
            margin-top: 15px;
        }

        form label:first-child {
            margin-top: 0;
        }

        /* Styling Input Box & Select */
        form input[type="text"],
        form input[type="password"],
        form select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
            background-color: #fff;
        }

        /* Efek saat form sedang diketik */
        form input[type="text"]:focus,
        form input[type="password"]:focus,
        form select:focus {
            border-color: #0056b3;
            outline: none;
            box-shadow: 0 0 5px rgba(0, 86, 179, 0.2);
        }

        /* Styling Tombol Register */
        form input[type="submit"] {
            width: 100%;
            padding: 14px;
            background-color: #0056b3; /* Warna biru untuk tombol daftar */
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            margin-top: 25px;
            transition: background-color 0.3s ease, transform 0.1s ease;
        }

        form input[type="submit"]:hover {
            background-color: #004494;
        }

        form input[type="submit"]:active {
            transform: scale(0.98);
        }

        /* Link Kembali ke Login */
        .login-link {
            margin-top: 20px;
            font-size: 0.95rem;
            color: #666;
            text-align: center;
        }

        .login-link a {
            color: #0056b3;
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s ease;
        }

        .login-link a:hover {
            color: #004494;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    
    <div class="register-container">
        <h1>Register</h1>
        
        <!-- Pesan Error Dinamis dari EJS -->
        <% if(error) { %>
        <div class="alert-danger">
            <%= error %>
        </div>
        <% } %>
        
        <form action="/user/register" method="post">
            <!-- Label dan Input -->
            <label for="email">Email:</label>
            <input type="text" name="email" id="email" placeholder="contoh@email.com" required>
            
            <label for="password">Password:</label>
            <input type="password" name="password" id="password" placeholder="Buat password Anda" required>
            
            <label for="role">Role:</label>
            <select name="role" id="role">
                <option value="user">User</option>
                <option value="admin">Admin</option>
            </select>
            
            <label for="nama">Name:</label>
            <input type="text" name="nama" id="nama" placeholder="Nama lengkap Anda" required>
            
            <label for="foto">Photo (URL):</label>
            <input type="text" name="foto" id="foto" placeholder="Link foto profil (opsional)">
            
            <label for="ktp">KTP:</label>
            <input type="text" name="ktp" id="ktp" placeholder="Nomor KTP">
            
            <label for="phoneNumber">Phone Number:</label>
            <input type="text" name="phoneNumber" id="phoneNumber" placeholder="Nomor telepon aktif">
            
            <input type="submit" value="Register">
        </form>
        
        <div class="login-link">
            Already have an account? <a href="/user/login">Login</a>
        </div>
    </div>

</body>
</html>